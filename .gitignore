# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# local database
prisma/dev.db
prisma/*.db
prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# local / generated build junk
.android-build/
*.apk
build-apk.log
supabase/.temp/

# stray local media dumps
/WhatsApp Image*.jpeg
/WhatsApp Image*.jpg

# Android local machine config / build outputs
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/captures/
android/capacitor-cordova-android-plugins/build/

# synthetic showcase database (safe to commit)
!prisma/demo.db
